# Copy this file to ".env" (same folder) and fill in the values.
# Never commit or share the real .env file - it holds secrets.

# From TikTok for Developers -> ReactionFlow -> Credentials -> Client key
TIKTOK_CLIENT_KEY=

# Must exactly match the Redirect URI registered in the app (Login Kit):
TIKTOK_REDIRECT_URI=https://deft-hummingbird-07156c.netlify.app/auth/callback

# Filled in AFTER running tiktok_login.py and opening the Netlify callback page in your browser:
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
